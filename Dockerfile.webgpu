# Experimental native WebGPU/Vulkan image (Linux x86_64).
FROM rust:1.99.0-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN rustup component add clippy
COPY scripts/fetch_webgpu_runtime.py /tmp/fetch_webgpu_runtime.py
RUN python3 /tmp/fetch_webgpu_runtime.py --output /opt/ort
ENV BLUE_ONYX_ORT_LIB_DIR=/opt/ort
COPY . .
RUN cargo test --locked --all-targets --features webgpu && \
    cargo clippy --locked --all-targets --features webgpu -- -D warnings && \
    cargo build --locked --release --bin blue_onyx --features webgpu

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl libssl3t64 libgomp1 libvulkan1 mesa-vulkan-drivers && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --uid 10001 --create-home blueonyx && \
    mkdir -p /app/config /app/models /app/cache && chown -R blueonyx:blueonyx /app
WORKDIR /app
COPY --from=builder /src/target/release/blue_onyx ./blue_onyx
COPY --from=builder /opt/ort/ ./ort-libs/
COPY --from=builder /src/LICENSE ./LICENSE
ENV ORT_DYLIB_PATH=/app/ort-libs/libonnxruntime.so \
    LD_LIBRARY_PATH=/app/ort-libs \
    BLUE_ONYX_WEBGPU_PLUGIN_PATH=/app/ort-libs/libonnxruntime_providers_webgpu.so \
    BLUE_ONYX_CONFIG_PATH=/app/config/blue_onyx_config.json \
    BLUE_ONYX_MODEL_DIR=/app/models \
    XDG_CACHE_HOME=/app/cache
USER blueonyx
EXPOSE 32168
HEALTHCHECK --interval=15s --timeout=3s --start-period=180s --retries=3 \
    CMD curl -fsS http://127.0.0.1:32168/health/ready || exit 1
ENTRYPOINT ["./blue_onyx"]
